# Backend URL is consumed by Next.js API route
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Optional LLM orchestration toggles
AGENT_ENABLE_LLM=false
OLLAMA_MODEL=qwen2.5:14b

# Verification mode: mock | sandbox | live
VERIFICATION_MODE=mock

# Optional Setu live verification APIs
SETU_BEARER_TOKEN=replace_with_setu_token
SETU_GST_VERIFY_URL=https://api.setu.co/data/gst/{gstin}
SETU_PAN_VERIFY_URL=https://api.setu.co/data/pan/{pan}

# API hardening
MAX_REQUEST_BYTES=65536

# Google Sheets integration (optional)
GOOGLE_SHEETS_ID=replace_with_target_sheet_id
GOOGLE_SHEETS_API_KEY=replace_with_google_api_key
GOOGLE_SHEETS_RANGE=Sheet1!A1
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# Alternative to file path:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# SMTP email integration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password_or_app_password
REPORT_FROM_EMAIL=sender@example.com
REPORT_TO_EMAIL=recipient@example.com

# API behavior and safety
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CORS_ALLOW_ORIGINS=http://localhost:3000
ARTIFACT_BASE_URL=http://127.0.0.1:8000
ARTIFACT_BASE_DIR=./artifacts
ARTIFACT_RETENTION_HOURS=24
MAX_ARTIFACT_RUNS=200
